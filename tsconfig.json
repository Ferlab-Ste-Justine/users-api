{
    "compilerOptions": {
        "resolveJsonModule": true,
        "module": "commonjs",
        "esModuleInterop": true,
        "target": "es6",
        "lib": ["es2022"],
        "moduleResolution": "node",
        "sourceMap": true,
        "outDir": "dist",
        "skipLibCheck": true
    },
    "exclude": ["node_modules"],
    "include": [
        "src/**/*"
    ]
}
